<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>NFCReaderUsageDescription</key>
  <string>Any Two Keys reads your security key or smart card when you hold it to the phone, to sign with it or set it up.</string>
  <!-- the parts of a YubiKey the app may select over NFC: OpenPGP (signing), management, one-time codes, authenticator, PIV. The last three are only ever read. -->
  <key>com.apple.developer.nfc.readersession.iso7816.select-identifiers</key>
  <array>
    <string>D27600012401</string>
    <string>A000000527471117</string>
    <string>A0000005272001</string>
    <string>A0000005272101</string>
    <string>A000000308</string>
  </array>
  <key>NSFaceIDUsageDescription</key>
  <string>Any Two Keys asks for Face ID to open what it keeps encrypted on this iPhone.</string>
  <key>NSCameraUsageDescription</key>
  <string>Any Two Keys uses the camera to read QR codes: an address to pay, a signed transaction, a signing device's key.</string>
  <key>NSLocalNetworkUsageDescription</key>
  <string>Any Two Keys can talk to a Bitcoin node of your own on this network.</string>
  <!-- iOS 27 will not launch an app built with its SDK unless the app adopts the scene lifecycle. The windowing
       library (tao) only registers its scene delegate when this says scenes are supported; an iPhone still shows one. -->
  <key>UIApplicationSceneManifest</key>
  <dict>
    <key>UIApplicationSupportsMultipleScenes</key>
    <true/>
  </dict>
  <!-- Export compliance, answered once for every build: the app uses only standard, published algorithms
       (XChaCha20-Poly1305, AES, HKDF, secp256k1, TLS), which Apple classes as exempt. Piers gave this answer in
       App Store Connect for the first build on 2026-10-06. -->
  <!-- The app ships its own XChaCha20-Poly1305/AES/ECDSA: non-exempt, standard algorithms. The French encryption
       declaration (App Store Connect d494fe91, filed 2026-10-06) was APPROVED on 2026-11-10 and this is its code, so
       every build inherits the answer. The key was absent from 8 Nov to 10 Nov while the code did not yet exist
       (altool refused uploads that carried an empty code against the pending declaration). -->
  <key>ITSAppUsesNonExemptEncryption</key>
  <true/>
  <key>ITSEncryptionExportComplianceCode</key>
  <string>ec4195ef-81ec-473f-9fc8-e96033ca77b2</string>
  <key>UIFileSharingEnabled</key>
  <true/>
  <key>LSSupportsOpeningDocumentsInPlace</key>
  <true/>
</dict>
</plist>
