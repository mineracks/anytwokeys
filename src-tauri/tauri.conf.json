{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Any Two Keys",
  "version": "0.1.0",
  "identifier": "com.anytwokeys.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Any Two Keys",
        "width": 1180,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; script-src 'self' 'wasm-unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Finance",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "Entitlements.plist"
    },
    "iOS": {
      "developmentTeam": "NB859QPG78",
      "minimumSystemVersion": "16.0"
    },
    "android": {
      "versionCode": 1001
    },
    "linux": {
      "deb": {
        "depends": [
          "libpcsclite1",
          "libudev1"
        ]
      }
    }
  }
}
